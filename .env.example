# Request an API key from the NEIS Education Information Open Portal.
# This placeholder is safe to commit; copy this file to .env and replace it.
NEIS_API_KEY=your_neis_api_key_here
# Data.go.kr's nationwide elementary/middle/high school location API.
# Copy the request URL shown in the data portal's Open API tab; it is not secret.
SCHOOL_LOCATION_API_URL=https://api.odcloud.kr/api/...
SCHOOL_LOCATION_API_KEY=your_data_go_kr_api_key_here
